# ─── Required ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development                        # 'production' on Render

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-minimum-64-chars

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key  # Service role key (NOT anon key)

# ─── Email (OTP delivery) ─────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key       # Falls back to console.log if not set

# ─── DartPOS integration ──────────────────────────────────────────────────────
DART_POS_URL=https://xxxx.ngrok.io          # ngrok tunnel URL when active
DART_POS_EXCLUDED_LOCATIONS=al-ghurair      # Comma-separated location IDs to skip
DART_WAITER_ID=3
DART_TABLE_ID=1
DART_REGION_ID=1
DART_TAX_ID=1
DART_TAX_RATE=0.05
DART_ORDER_TYPE=1                           # 1 = takeaway

# ─── Scaling / observability ──────────────────────────────────────────────────
INSTANCE_ID=local                           # Unique per instance — set in Render env vars

# ─── Secret management (recommended, free) ────────────────────────────────────
# Doppler: https://doppler.com
# 1. doppler setup  (run once in this dir)
# 2. doppler run -- npm run dev
# Syncs all vars to Render automatically via Doppler → Render integration (no manual copy-paste)
